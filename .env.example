# PostgreSQL
POSTGRES_USER=matching
POSTGRES_PASSWORD=matching
POSTGRES_DB=matching
DATABASE_URL=postgresql+psycopg://matching:matching@db:5432/matching

# OpenAI / Cursor / Anthropic / Gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Cursor Dashboard → Integrations で発行（SDK / エージェント用）
CURSOR_API_KEY=
# Anthropic Console で発行（Claude API。メール要約 / AI採点のフォールバック）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Google AI Studio で発行（メール要約・AI判定の最優先）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BATCH_SIZE=20
GEMINI_BATCH_PARALLEL=10
GEMINI_BATCH_WAVE_INTERVAL_SECONDS=60
GEMINI_INPUT_TPM=250000

# Google Routes（BAT-003 通勤時間・Compute Routes Essentials）
# Cloud Console で Routes API を有効化し Billing を紐づけたうえで API キーを設定
# 未設定時は通勤枠を中立点のまま（Pass2 の API 呼び出しをスキップ）
GOOGLE_MAPS_API_KEY=
# 月間ソフト上限（無料枠 10,000 に合わせる）
GOOGLE_ROUTES_MONTHLY_WARN=8000
GOOGLE_ROUTES_MONTHLY_LIMIT=10000

# Gmail (mount JSON files under ./secrets, do not commit them)
GMAIL_CREDENTIALS_PATH=/secrets/credentials.json
GMAIL_TOKEN_PATH=/secrets/token.json
# 方法1: credentials.json を secrets/ に置く
# 方法2: 以下を設定すると API 起動時に credentials.json を自動生成（推奨）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_PROJECT_ID=matching-service
GMAIL_LABEL_TALENT=SES人材紹介
GMAIL_LABEL_PROJECT=SES案件配信

# Gmail ingest (BAT-002) — labels are created by Gmail filters
BATCH_JOB=pipeline
GMAIL_SORT_LABEL_TALENT=SES人材紹介
GMAIL_SORT_LABEL_PROJECT=SES案件配信
GMAIL_PROCESSED_LABEL_TALENT=SES人材紹介（処理済み）
GMAIL_PROCESSED_LABEL_PROJECT=SES案件配信（処理済み）

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# 本番では公開 URL を指定（未設定時はローカルでは localhost から自動生成）
API_PUBLIC_BASE_URL=
WEB_PUBLIC_BASE_URL=
WEB_SETTINGS_URL=

# Ingest data retention (BAT-006). 0 = disabled
INGEST_DATA_RETENTION_DAYS=0
