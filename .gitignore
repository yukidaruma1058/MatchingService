# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
web/.next/
web/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Gmail credentials (never commit)
secrets/*
!secrets/.gitkeep
**/credentials.json
**/token.json

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Docker / logs
*.log
log/*
!log/.gitkeep
batch/tmp/
log/batch_tmp/
# Linux core dumps (batch pipeline crash)
core
core.*
batch/core.*
